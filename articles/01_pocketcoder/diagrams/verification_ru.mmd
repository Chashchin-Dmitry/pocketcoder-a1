flowchart TD
    Agent["Агент говорит: COMPLETED"] --> Gate["Шлюз верификации"]

    Gate --> Tier1["УРОВЕНЬ 1: БЛОКИРУЮЩИЙ"]
    Tier1 --> Syntax["py_compile все .py файлы"]
    Tier1 --> Tests["pytest"]
    Tier1 --> Files["изменённые файлы существуют?"]
    Tier1 --> Criteria["критерии успеха выполнены?"]

    Syntax --> B1{Всё пройдено?}
    Tests --> B1
    Files --> B1
    Criteria --> B1

    B1 -->|Да| Tier2["УРОВЕНЬ 2: ПРЕДУПРЕЖДЕНИЕ (только лог)"]
    B1 -->|Нет, НОВАЯ проблема| AntiLoop

    Tier2 --> Lint["ruff (линтер)"]
    Tier2 --> Build["python -m build / npm run build"]
    Tier2 --> Git["git diff + status"]

    Lint --> Accept["ПРИНЯТО: Сессия завершена"]
    Build --> Accept
    Git --> Accept

    subgraph AntiLoop["УРОВЕНЬ 3: ЗАЩИТА ОТ ЗАЦИКЛИВАНИЯ"]
        Check["Это НОВАЯ проблема?\n(сравнить с baseline)"]
        Check -->|Была ранее| Skip["Пропустить (не вина агента)"]
        Check -->|Новая| RetryCheck{"попыток < 3?"}
        RetryCheck -->|Да| Inject["Вставить ошибки\nв промпт следующей сессии"]
        RetryCheck -->|Нет| Force["ПРИНУДИТЕЛЬНОЕ ПРИНЯТИЕ\n(остановить бесконечный цикл)"]
    end

    Skip --> Accept
    Force --> Accept

    style Tier1 fill:#ef4444,color:#fff
    style Tier2 fill:#f59e0b,color:#000
    style AntiLoop fill:#6366f1,color:#fff
    style Accept fill:#10b981,color:#fff
