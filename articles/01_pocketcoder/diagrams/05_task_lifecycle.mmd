---
config:
  theme: base
  layout: elk
---
flowchart TD
    subgraph Create["Task creation: 3 ways"]
        Way1["CLI<br/>pca task add 'title'"]
        Way2["Dashboard<br/>Quick Add form<br/>POST /add-task"]
        Way3["AI Transform<br/>raw text into tasks<br/>with priorities and criteria"]
    end

    Way1 --> TaskJSON
    Way2 --> TaskJSON
    Way3 --> Preview["Preview<br/>cards with checkboxes<br/>ADD SELECTED"] --> TaskJSON

    TaskJSON[".a1/tasks.json<br/>id, title, description,<br/>status, priority,<br/>success_criteria"]

    TaskJSON --> Pending["PENDING<br/>waiting for execution"]

    Pending --> InProgress["IN PROGRESS<br/>agent picked task<br/>by priority"]

    InProgress --> AgentWork["Agent working:<br/>Read, Edit, Write, Bash<br/>max 25 turns per session"]

    AgentWork --> Verify{"Verification<br/>passed?"}

    Verify -->|"Yes"| TaskDone["DONE<br/>green checkmark"]

    Verify -->|"No, retry < 5"| AgentWork
    Verify -->|"No, retry >= 5"| TaskBlocked["BLOCKED<br/>reason saved"]

    TaskDone --> NextCheck{"More pending?"}
    NextCheck -->|"Yes"| Pending
    NextCheck -->|"No"| AllDone(["ALL DONE<br/>status = COMPLETED"])

    TaskBlocked --> NextCheck2{"Mode?"}
    NextCheck2 -->|"all tasks"| Pending
    NextCheck2 -->|"--task"| Stopped(["STOP"])

    subgraph Priority["Priority system"]
        direction LR
        P1["#1"] --> P2["#2"] --> P3["#3"] --> P4["#4"] --> P5["#5"]
        DnD["Drag and Drop<br/>POST /api/reorder"]
    end

    style Pending fill:#f59e0b,color:#000
    style InProgress fill:#3b82f6,color:#fff
    style TaskDone fill:#10b981,color:#fff
    style TaskBlocked fill:#ef4444,color:#fff
    style AllDone fill:#10b981,color:#fff
    style Stopped fill:#ef4444,color:#fff
    style Way3 fill:#8b5cf6,color:#fff
