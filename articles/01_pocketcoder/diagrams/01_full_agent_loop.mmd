---
config:
  theme: base
  layout: elk
---
flowchart TD
    Start(["pca start"]) --> Mode{"Mode?"}
    Mode -->|"all tasks"| AllTasks["All tasks<br/>get_next_task()<br/>by priority"]
    Mode -->|"--task task_001"| SingleTask["Single task"]

    AllTasks --> Baseline
    SingleTask --> Baseline

    Baseline["Capture baseline<br/>validator.run_all() BEFORE work<br/>pre-existing bugs excluded"]
    Baseline --> SessionStart

    SessionStart["Start session<br/>session++ / status=WORKING"]
    SessionStart --> BuildPrompt

    BuildPrompt["Build prompt<br/>checkpoint + tasks +<br/>queue + verification errors"]
    BuildPrompt --> QueueCheck

    QueueCheck{"Messages in<br/>queue.json?"}
    QueueCheck -->|"Yes"| InjectQueue["Inject user messages<br/>into prompt"]
    QueueCheck -->|"No"| Provider
    InjectQueue --> Provider

    Provider{"Provider?"}
    Provider -->|"claude-max"| ClaudeMax["Claude CLI subprocess<br/>Stream-JSON, all tools"]
    Provider -->|"claude-api"| ClaudeAPI["Anthropic SDK<br/>Agentic loop, 6 tools"]
    Provider -->|"ollama"| OllamaP["Ollama Client<br/>Text only, no tool calling"]

    ClaudeMax --> StreamParse
    ClaudeAPI --> StreamParse
    OllamaP --> StreamParse

    StreamParse["Real-time parsing<br/>NDJSON line by line"]

    StreamParse --> ContextCheck{"Context >= 70%?"}
    ContextCheck -->|"Yes"| AutoCheckpoint["Auto-checkpoint<br/>save state<br/>terminate session"]
    AutoCheckpoint --> SessionDelay
    ContextCheck -->|"No"| SessionEnd

    SessionEnd["Session finished<br/>metrics saved"]

    SessionEnd --> Verify["Verification"]

    Verify --> T1{"Blocking checks<br/>passed?"}

    T1 -->|"Yes"| T2["Warnings<br/>ruff, build, git diff"]
    T2 --> Completed

    T1 -->|"No"| BaselineCheck{"New problem?<br/>compare with baseline"}
    BaselineCheck -->|"Old bug"| T2
    BaselineCheck -->|"New bug"| RetryCheck{"retry < 5?"}

    RetryCheck -->|"Yes"| RetrySession["Retry: inject errors<br/>into next session prompt"]
    RetrySession --> SessionDelay

    RetryCheck -->|"No"| BlockTask["Task BLOCKED"]

    BlockTask --> BlockMode{"Mode?"}
    BlockMode -->|"Single task"| StopBlocked(["STOP: BLOCKED"])
    BlockMode -->|"All tasks"| NextTask{"More pending?"}
    NextTask -->|"Yes"| PickNext["Next task"]
    PickNext --> SessionStart
    NextTask -->|"No"| StopNoTasks(["STOP: no tasks"])

    Completed{"All tasks done?"}
    Completed -->|"No"| SessionDelay
    Completed -->|"Yes"| AllDone(["ALL DONE"])

    SessionDelay["Delay 5 sec"]
    SessionDelay --> SessionStart

    style Start fill:#6366f1,color:#fff
    style AllDone fill:#10b981,color:#fff
    style StopBlocked fill:#ef4444,color:#fff
    style StopNoTasks fill:#f59e0b,color:#000
    style Verify fill:#f59e0b,color:#000
    style BlockTask fill:#ef4444,color:#fff
    style AutoCheckpoint fill:#8b5cf6,color:#fff
    style Baseline fill:#3b82f6,color:#fff
    style ClaudeMax fill:#6366f1,color:#fff
    style ClaudeAPI fill:#f97316,color:#fff
    style OllamaP fill:#10b981,color:#fff
