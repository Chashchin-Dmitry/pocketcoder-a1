    style Flags fill:#312e81,color:#c7d2fe,stroke:#4338ca
    style Stream fill:#1e293b,color:#e2e8f0,stroke:#475569
    style ToolMap fill:#1e293b,color:#e2e8f0,stroke:#475569
    style Callback fill:#064e3b,color:#a7f3d0,stroke:#059669
