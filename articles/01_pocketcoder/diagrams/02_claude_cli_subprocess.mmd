---
config:
  theme: base
  layout: elk
---
flowchart TD
    subgraph Python["loop.py"]
        EnvClean["env = os.environ.copy()<br/>env.pop('CLAUDECODE', None)"]
        EnvWhy["CLAUDECODE=1 in environment<br/>nested claude crashes<br/>remove the variable"]

        EnvClean --> Popen

        Popen["subprocess.Popen(<br/>['claude', '-p', prompt, ...],<br/>cwd=project_dir,<br/>stdout=PIPE, text=True)"]
    end

    subgraph Flags["6 required flags"]
        F1["-p prompt<br/>non-interactive mode"]
        F2["--dangerously-skip-permissions<br/>auto-approve tool_use"]
        F3["--no-session-persistence<br/>don't pollute history"]
        F4["--max-turns 25<br/>iteration limit"]
        F5["--verbose<br/>required with stream-json + -p"]
        F6["--output-format stream-json<br/>NDJSON stream"]
    end

    Popen --> ReadLoop

    subgraph Stream["Real-time stream parsing"]
        ReadLoop["while True:<br/>line = proc.stdout.readline()"]
        ReadLoop --> ParseJSON["event = json.loads(line)"]
        ParseJSON --> EventType{"event type?"}

        EventType -->|"system"| Skip1["SKIP"]
        EventType -->|"user"| Skip2["SKIP"]

        EventType -->|"assistant"| ParseContent["Parse content[]"]
        ParseContent --> BlockType{"block type?"}

        BlockType -->|"tool_use"| ToolClassify["Classify tool<br/>tools_used += 1"]
        BlockType -->|"text"| TextOut["Text output"]
        BlockType -->|"thinking"| ThinkOut["Extended thinking"]

        EventType -->|"rate_limit_event"| Metrics["Update metrics:<br/>tokens_in, tokens_out<br/>cache_read, context%"]

        EventType -->|"result"| Result["Final answer"]
    end

    subgraph ToolMap["Classification: 8 types"]
        ToolClassify --> TM1["Read / Glob / Grep<br/>read, blue"]
        ToolClassify --> TM2["Edit<br/>edit, orange"]
        ToolClassify --> TM3["Write<br/>write, green"]
        ToolClassify --> TM4["Bash<br/>bash, purple"]
        ThinkOut --> TM5["thinking, yellow"]
        TextOut --> TM6["text, gray"]
        Metrics --> TM7["metric, indigo"]
        Result --> TM8["verify, green"]
    end

    subgraph Callback["Send to dashboard"]
        TM1 --> LogCB["_log_callback(text, type)"]
        TM2 --> LogCB
        TM3 --> LogCB
        TM4 --> LogCB
        TM5 --> LogCB
        TM6 --> LogCB
        TM7 --> LogCB
        TM8 --> LogCB
        LogCB --> Buffer["AGENT_LOG_BUFFER"]
        Buffer --> AJAX["/api/log?since=N<br/>every 2 seconds"]
        AJAX --> DOM["Browser: icon + color + text"]
    end

    style Popen fill:#6366f1,color:#fff
    style EnvWhy fill:#ef4444,color:#fff
    style Buffer fill:#f59e0b,color:#000
    style DOM fill:#10b981,color:#fff
