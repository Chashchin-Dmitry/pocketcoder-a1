%%{ init: { 'theme': 'dark', 'themeVariables': { 'fontSize': '14px' } } }%%
flowchart TD
    %% === PYTHON SIDE ===
    subgraph Python["Python (loop.py)"]
        EnvClean["env = os.environ.copy()\nenv.pop('CLAUDECODE', None)"]
        EnvWhy["Зачем: Claude Code ставит CLAUDECODE=1\nВложенный вызов claude падает:\n'cannot launch inside another session'\nУдаляем — и subprocess работает"]

        EnvClean --> Popen

        Popen["subprocess.Popen(\n  ['claude', '-p', prompt, ...],\n  cwd=project_dir,\n  env=env,\n  stdout=PIPE,\n  stderr=STDOUT,\n  text=True, bufsize=1\n)"]
    end

    subgraph Flags["6 обязательных флагов"]
        F1["-p prompt\nНеинтерактивный режим"]
        F2["--dangerously-skip-permissions\nАвтоподтверждение всех tool_use\n(иначе каждый Read/Edit ждёт ввода)"]
        F3["--no-session-persistence\nНе засорять историю сессий Claude"]
        F4["--max-turns 25\nЛимит итераций\n(защита от бесконечной работы)"]
        F5["--verbose\nОБЯЗАТЕЛЬНО с stream-json + -p\n(без него: ошибка парсинга)"]
        F6["--output-format stream-json\nNDJSON: одна строка = одно событие\n(вместо буферизации всего stdout)"]
    end

    Popen --> ReadLoop

    %% === STREAM PARSING ===
    subgraph Stream["Real-time парсинг потока"]
        ReadLoop["while True:\n  line = proc.stdout.readline()\n  if not line and proc.poll() is not None: break"]
        ReadLoop --> ParseJSON["event = json.loads(line)"]
        ParseJSON --> EventType{"event['type'] = ?"}

        EventType -->|"system"| Skip1["SKIP\n(инициализация)"]
        EventType -->|"user"| Skip2["SKIP\n(tool_result от Claude)"]

        EventType -->|"assistant"| ParseContent["Разбор content[] блоков"]
        ParseContent --> BlockType{"block['type'] = ?"}

        BlockType -->|"tool_use"| ToolClassify["Классификация инструмента\ntools_used += 1"]
        BlockType -->|"text"| TextOut["Текстовый вывод\n(обрезка до 150 символов)"]
        BlockType -->|"thinking"| ThinkOut["Extended thinking\n(обрезка до 100 символов)"]

        EventType -->|"rate_limit_event"| Metrics["Обновление метрик:\ntokens_in = usage.input_tokens\ntokens_out = usage.output_tokens\ncache_read / cache_creation\ncontext_percent = in / 200K"]

        EventType -->|"result"| Result["Финальный ответ агента\nsession_result = text[:500]"]
    end

    %% === TOOL CLASSIFICATION ===
    subgraph ToolMap["Классификация tool_use → 8 типов иконок"]
        ToolClassify --> TM1["Read / Glob / Grep → 'read'\nсиний, иконка глаза"]
        ToolClassify --> TM2["Edit → 'edit'\nоранжевый, иконка карандаша"]
        ToolClassify --> TM3["Write → 'write'\nзелёный, иконка файла"]
        ToolClassify --> TM4["Bash → 'bash'\nфиолетовый, иконка терминала"]
        ThinkOut --> TM5["thinking\nжёлтый, иконка лампочки"]
        TextOut --> TM6["text\nсерый, иконка чата"]
        Metrics --> TM7["metric\nиндиго, иконка спидометра"]
        Result --> TM8["verify (при верификации)\nзелёный, иконка щита"]
    end

    %% === CALLBACK ===
    subgraph Callback["Отправка в дашборд"]
        TM1 --> LogCB["_log_callback(display_text, event_type)"]
        TM2 --> LogCB
        TM3 --> LogCB
        TM4 --> LogCB
        TM5 --> LogCB
        TM6 --> LogCB
        TM7 --> LogCB
        TM8 --> LogCB
        LogCB --> Buffer["AGENT_LOG_BUFFER\n(глобальный список в dashboard.py)"]
        Buffer --> AJAX["AJAX /api/log?since=N\nкаждые 2 секунды"]
        AJAX --> DOM["Браузер: иконка + цвет + текст"]
    end

