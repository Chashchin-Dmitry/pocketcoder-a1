---
config:
  theme: base
  layout: elk
---
flowchart TD
    Agent["Agent says: COMPLETED"] --> Gate["Verification<br/>_verify_session()"]

    Gate --> T1["TIER 1: BLOCKING"]
    T1 --> S1["py_compile<br/>all .py files"]
    T1 --> S2["pytest -v"]
    T1 --> S3["Files from checkpoint<br/>exist on disk?"]
    T1 --> S4["success_criteria<br/>met?"]

    S1 --> Pass{"All pass?"}
    S2 --> Pass
    S3 --> Pass
    S4 --> Pass

    Pass -->|"Yes"| T2["TIER 2: WARNING<br/>non-blocking, log only"]
    T2 --> L1["ruff check"]
    T2 --> L2["build"]
    T2 --> L3["git diff + status"]
    L1 --> Done(["ACCEPTED<br/>task marked done"])
    L2 --> Done
    L3 --> Done

    Pass -->|"No"| Baseline{"Existed BEFORE<br/>agent started?<br/>baseline snapshot"}

    Baseline -->|"Old bug"| Done
    Baseline -->|"New bug"| Retry{"retry < 5?"}

    Retry -->|"Yes"| FixPrompt["Inject errors into<br/>next session prompt:<br/>VERIFICATION FAILED<br/>attempt 2/5<br/>BLOCKING: tests 2 failed"]
    FixPrompt --> NextSession["New session<br/>agent tries to fix"]

    Retry -->|"5 attempts"| Blocked["Task BLOCKED<br/>reason saved"]
    Blocked --> WhatNext{"Mode?"}
    WhatNext -->|"--task"| Stop(["STOP"])
    WhatNext -->|"all tasks"| Next["Next task"]

    style Agent fill:#6366f1,color:#fff
    style T1 fill:#ef4444,color:#fff
    style T2 fill:#f59e0b,color:#000
    style Done fill:#10b981,color:#fff
    style Blocked fill:#ef4444,color:#fff
    style Stop fill:#ef4444,color:#fff
    style FixPrompt fill:#8b5cf6,color:#fff
    style Baseline fill:#3b82f6,color:#fff
