---
config:
  theme: base
  layout: elk
---
flowchart LR
    subgraph Agent["Agent (loop.py)"]
        direction TB
        Claude["Claude CLI<br/>subprocess"]
        Claude --> StreamJSON["Stream-JSON<br/>NDJSON lines"]
        StreamJSON --> Parse["_parse_stream_event()"]

        Parse --> ToolUse["tool_use:<br/>Read / Edit / Write / Bash"]
        Parse --> TextBlock["text:<br/>agent response"]
        Parse --> RateLimit["rate_limit_event:<br/>tokens in / out / cache"]
        Parse --> ResultBlock["result:<br/>final answer"]
    end

    subgraph Bridge["Agent -> Dashboard"]
        direction TB
        ToolUse --> LogCB["_log_callback(text, type)"]
        TextBlock --> LogCB
        RateLimit --> MetricsUpdate["_session_metrics<br/>tokens_in += N<br/>tokens_out += N<br/>tools_used += 1"]
        ResultBlock --> LogCB

        LogCB --> Buffer["AGENT_LOG_BUFFER<br/>append(text, type, time)"]
        MetricsUpdate --> SessionMetrics["get_session_metrics()<br/>tokens, cost,<br/>duration, context%"]
    end

    subgraph Server["HTTP server (dashboard.py)"]
        direction TB
        Buffer --> APILog["/api/log?since=N<br/>entries from index N"]
        SessionMetrics --> APIStatus["/api/status<br/>checkpoint + tasks + metrics"]

        QueueForm["POST /queue-message"] --> QueueFile[".a1/queue.json"]
        QueueFile --> NextPrompt["build_prompt()<br/>reads queue.json"]
    end

    subgraph Browser["Browser"]
        direction TB
        APILog --> JSLog["updateLog()<br/>every 2 sec"]
        APIStatus --> JSStatus["updateStatus()<br/>every 3 sec"]

        JSLog --> LogPanel["Log panel<br/>icons + colors + text<br/>8 event types"]

        JSStatus --> Cards["6 metric cards"]
        Cards --> C1["Tasks<br/>2/5 done"]
        Cards --> C2["Session<br/>#3 WORKING"]
        Cards --> C3["Tokens<br/>12.4K / 3.2K"]
        Cards --> C4["Cost<br/>$0.08"]
        Cards --> C5["Duration<br/>48s"]
        Cards --> C6["Files<br/>3 modified"]

        Timer["tickTimer()<br/>every second"] --> C5
    end

    style Claude fill:#6366f1,color:#fff
    style Buffer fill:#f59e0b,color:#000
    style SessionMetrics fill:#f59e0b,color:#000
    style Cards fill:#6366f1,color:#fff
    style LogPanel fill:#10b981,color:#fff
