# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Venv
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Sandbox / test projects
sandbox/

# Integration test artifacts
tests/result/

# Environment variables for Claude API keys
*.env
.env

# Images / screenshots (general)
*.JPG
*.jpg
*.png
*.PNG

# Allow article images
!articles/**/*.png
!articles/**/*.jpg
!docs/tutorial/screenshots/**/*.png
!docs/images/**/*.png

# A1 data (keep structure, ignore content)
.a1/sessions/*
.a1/checkpoints/*
.a1/test-reports/*
!.a1/sessions/.gitkeep
!.a1/checkpoints/.gitkeep
!.a1/test-reports/.gitkeep
